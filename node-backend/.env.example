# copy to .env and fill in
PORT=5000

# mongodb atlas → connect → drivers
MONGODB_URI=mongodb+srv://CHANGE_ME:CHANGE_ME@cluster0.CHANGE_ME.mongodb.net/sportsphere?retryWrites=true&w=majority

# google cloud console → credentials → oauth client id
GOOGLE_CLIENT_ID=CHANGE_ME

# any long random string, keep it secret
JWT_SECRET=CHANGE_ME

# razorpay dashboard → settings → api keys (use TEST mode keys)
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME

# google ai studio → get api key (free) — powers the "ask for help" chatbot
# optional: chatbot falls back to built-in answers when missing
GEMINI_API_KEY=CHANGE_ME

# where the frontend is served from (for google redirect + cors)
FRONTEND_URL=http://localhost:8080
